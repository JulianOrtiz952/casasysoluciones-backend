# Variables de entorno para Casas y Soluciones (Backend)

# Entorno: 'development' o 'production'
APP_ENV=development

# Modo Debug ('True' en desarrollo, 'False' en producción)
DEBUG=True

# Clave secreta de Django (OBLIGATORIA en producción)
DJANGO_SECRET_KEY=tu-clave-secreta-aqui

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes CORS y CSRF permitidos
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Motor de Base de Datos ('sqlite' o 'postgresql')
DB_ENGINE=sqlite

# Para Producción con SQLite (Ruta dentro del volumen persistente /app/data)
SQLITE_DB_PATH=/app/data/db.sqlite3

# Para Producción con PostgreSQL (Solo cuando DB_ENGINE=postgresql)
DATABASE_URL=


# Almacenamiento Cloudflare R2 / AWS S3 (Solo para Producción)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
